{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neopilot-secure-gateway",
  "main": "index.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "vars": {
    "DASHBOARD_URL": "https://maddalakum.github.io/neopilot-dashboard/",
    "ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173,https://maddalakum.github.io",
    "GITHUB_REPOSITORY": "maddalakum/Suploads"
  }
}
